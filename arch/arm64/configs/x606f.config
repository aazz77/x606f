# TB-X606F 第一阶段 bring-up 配置片段
# 用法: make ARCH=arm64 defconfig x606f.config   (内核 Makefile 会自动合并 arch/arm64/configs/*.config)

# --- 平台 / 中断 / 启动 ---
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_ARCH_TIMER=y

# --- 串口 (LK 已初始化 UART0) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y

# --- 屏幕: 先用 LK 的 simple-framebuffer ---
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y

# --- initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- 第二阶段会用到的 (mainline 已有 mt6765 驱动), 先编进去 ---
CONFIG_COMMON_CLK_MT6765=y
CONFIG_PINCTRL_MT6765=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MMC=y
CONFIG_MMC_MTK=y

# --- 调试 ---
CONFIG_PRINTK_TIME=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
